# {{ ansible_managed }}
# vmalert-правила birdman (docs/specs/ops.md §1). Пороги — ansible-переменные
# (подставляются в expr). Go-шаблоны vmalert в annotations ({{ '{{' }} $labels ... }})
# обёрнуты в {% raw %}...{% endraw %}, чтобы Jinja их НЕ трогала.
# Дисциплина файла: expr — только Jinja-переменные (без $); annotations.summary —
# только {% raw %}{{ $... }}{% endraw %} (без Jinja-переменных).
# Двуязычие (ops.md §1): annotations.description — EN (каноничный),
# annotations.description_ru — RU-перевод; обе — статические строки без шаблонов.
# Панель выбирает текст по локали и фоллбэчится на description, поэтому
# description обязателен, description_ru — опционален (свои правила self-host-
# операторов работают без него). summary остаётся одноязычной динамической
# ops-строкой (Discord/лог).
groups:
  - name: birdman-availability
    rules:
      # NodeDown: heartbeat_age растёт, пока агент молчит. for:0s + scrape/eval
      # по 15s → алерт ≤60s после остановки агента (ops.md §7, ит.4 acceptance).
      - alert: NodeDown
        expr: birdman_node_heartbeat_age_seconds > {{ birdman_heartbeat_max_age_seconds }}
        for: 0s
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'NodeDown {{ $labels.node }} ({{ $labels.region }}): heartbeat_age={{ $value }}s'{% endraw %}

          description: 'Node has been silent beyond the threshold; quarantine engaged (ops.md §1 NodeDown).'
          description_ru: 'Нода молчит > порога; сработал карантин (ops.md §1 NodeDown).'

      # Очередь agentlink не пустеет: pending>0 держится дольше
      # {{ birdman_pending_stuck_for }} при живом линке — Ack/реплей опустошают
      # её за секунды, значит нода залипла или команда отвергается. Метрика
      # эмитится только при pending>0: при дренаже серия исчезает (staleness),
      # expr перестаёт матчиться и pending-состояние алерта сбрасывается —
      # нет серии = нет алерта (absent-безопасно).
      - alert: AgentlinkPendingStuck
        expr: birdman_agentlink_pending_commands > 0
        for: {{ birdman_pending_stuck_for }}
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'AgentlinkPendingStuck: node {{ $labels.node }} держит {{ $value }} unacked-команд дольше порога'{% endraw %}

          description: 'The master→agent command queue is not draining (followups spec §3).'
          description_ru: 'Очередь команд master→agent не пустеет (спека followups §3).'

      # BufferEmpty (1/2): ready-буфер региона опустел и держится. Расщеплён на
      # ПАРУ по production (environments v1 §7): birdman_servers несёт лейбл
      # production (деривация — join environments по (project_id, s.env), НЕ
      # через nodes — I6). prod → critical, не-prod → warning: пустой буфер
      # боевого окружения будит, dev/стейджинг только предупреждает.
      # Агрегация — по (region, project): birdman_servers уже несёт project, и
      # sum by(region) его СТИРАЛ — пустой ready-буфер проекта А маскировался
      # серверами проекта Б в том же регионе (сужение — #955). Лейбл project
      # доезжает до алерта и делает его проектным для панели (?project= на
      # /v1/alerts/*, master.md §6). Формулировку #955 «алерт молчал ровно там,
      # где должен был гореть» правим по факту (#960): до явных нулей он молчал
      # ВЕЗДЕ, а сужение до project было верным, но ЛАТЕНТНЫМ — разницы не было
      # видно, пока правило не могло загореться вообще.
      # ПОЧЕМУ `== 0` вообще достижимо (tracker #960): birdman_servers — это
      # СГРУППИРОВАННЫЙ COUNT, у комбинации без строк серии НЕТ, а агрегация по
      # несуществующей серии даёт ПУСТО, а не 0. Оба правила этой пары были
      # мертвы при любом состоянии флота — хуже отсутствующего алерта, потому что
      # случай выглядел покрытым. Теперь master эмитит ЯВНЫЙ ноль ready-серии для
      # каждого флота с buffer_ready > 0 (master/internal/metrics/metrics.go,
      # collectReadyZeros): живые комбинации берутся из desired state
      # (fleet_configs), версия — активная у флота, поэтому кардинальность —
      # одна серия на флот, без декартова произведения. Флот с buffer_ready = 0
      # нуля НЕ получает (сознательно не держит тёплый буфер — будить не за что),
      # поэтому join по buffer_ready в expr не нужен: фильтр живёт в метрике.
      # Проверяется прогоном: roles/birdman_monitoring_dev/tests/run.sh.
      # Парный BufferEmptyAllocFail ниже (по allocation_failures, у которого
      # среза production НЕТ) остаётся страховкой, но он ловит уже СЛУЧИВШИЙСЯ
      # отказ аллокации — эта пара превентивна, поэтому её и чинили.
      - alert: BufferEmptyReadyProd
        expr: sum by (region, project, env) (birdman_servers{state="ready", production="true"}) == 0
        for: {{ birdman_ready_empty_for }}
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'BufferEmpty(prod): проект {{ $labels.project }}, окружение {{ $labels.env }}, регион {{ $labels.region }} без ready-серверов'{% endraw %}

          description: 'sum(birdman_servers{state="ready", production="true"}) == 0 for a (region, project, env) triple for longer than the threshold (ops.md §1 BufferEmpty). Grouping by env is required: one production slice of a project may hold several environments in the same region, and an empty buffer in one would be masked by servers of another.'
          description_ru: 'sum(birdman_servers{state="ready", production="true"}) == 0 по тройке (регион, проект, окружение) дольше порога (ops.md §1 BufferEmpty). Окружение в группировке обязательно: внутри одного production-среза у проекта их может быть несколько в одном регионе, и пустой буфер одного маскировался бы серверами другого.'

      - alert: BufferEmptyReadyNonProd
        expr: sum by (region, project, env) (birdman_servers{state="ready", production="false"}) == 0
        for: {{ birdman_ready_empty_for }}
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'BufferEmpty(non-prod): проект {{ $labels.project }}, окружение {{ $labels.env }}, регион {{ $labels.region }} без ready-серверов'{% endraw %}

          description: 'sum(birdman_servers{state="ready", production="false"}) == 0 for a (region, project, env) triple for longer than the threshold (ops.md §1 BufferEmpty). Grouping by env is required: dev and staging share the production=false slice, and an empty ready buffer in one would be masked by servers of the other.'
          description_ru: 'sum(birdman_servers{state="ready", production="false"}) == 0 по тройке (регион, проект, окружение) дольше порога (ops.md §1 BufferEmpty). Окружение в группировке обязательно: dev и staging живут в одном срезе production=false, и пустой ready-буфер одного маскировался бы серверами другого.'

      # BufferEmpty (2/2): аллокации падают из-за отсутствия ёмкости. Метрика
      # birdman_allocation_failures_total НЕ несёт лейбла production (пары по
      # production живут на СЕРВЕРНОЙ серии выше, environments v1 §7), поэтому это
      # ОДНО правило critical — заодно absent-страховка для обоих production-срезов
      # ready==0. Новый reason=env_required (409-ambiguous allocate) сюда не
      # попадает: expr фильтрует reason="no_capacity".
      # expr НЕ трогаем: метрика теперь несёт лейбл project (master, metrics.go),
      # и он доезжает до алерта сам — правило стало проектным без правки запроса.
      # summary поэтому называет проект: без этого на два разных проекта в
      # Discord/лог прилетали бы два неотличимых сообщения. project="" (запрос не
      # разобран) = лейбла нет → алерт остаётся платформенным и виден при любом
      # выбранном проекте.
      - alert: BufferEmptyAllocFail
        expr: increase(birdman_allocation_failures_total{reason="no_capacity"}[1m]) > 0
        for: 0s
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'BufferEmpty: проект {{ $labels.project }}, no_capacity аллокаций за 1м: {{ $value }}'{% endraw %}

          description: 'No free slots available for allocation (ops.md §1 BufferEmpty).'
          description_ru: 'Нет свободных слотов под аллокацию (ops.md §1 BufferEmpty).'

  - name: birdman-health
    rules:
      # CrashLoop: событие crash_loop от master (плохой релиз).
      # birdman_events_total{kind} деривится из БД, поэтому у ещё не случавшегося
      # вида серии не было вовсе, и она рождалась сразу со значением 1 —
      # increase() по константе 1 даёт 0, т.е. САМОЕ ПЕРВОЕ событие вида было
      # невидимо, алерт загорался только со второго (родня #960, найдено тем же
      # прогоном). master эмитит нулевую базу для алертных видов
      # (metrics.go, alertEventKinds) — две серии, первое событие видно.
      - alert: CrashLoop
        expr: increase(birdman_events_total{kind="crash_loop"}[5m]) > 0
        for: 0s
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'CrashLoop: событий crash_loop за 5м: {{ $value }}'{% endraw %}

          description: 'A bad release is likely — roll back (ops.md §6 runbook 3).'
          description_ru: 'Вероятен плохой релиз — rollback (ops.md §6 runbook 3).'

      # DiskHigh: диск агента. warning > {{ birdman_disk_warn_pct }}%, critical > {{ birdman_disk_crit_pct }}%
      # (две severities; при > crit сработают обе — это ок, alertmanager дедупит).
      - alert: DiskHighWarning
        expr: 100 * birdman_agent_disk_used_bytes / birdman_agent_disk_total_bytes > {{ birdman_disk_warn_pct }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'DiskHigh(warn): диск агента ({{ $labels.node }}) {{ $value }}%'{% endraw %}

          description: 'Node disk usage is above the warning threshold (ops.md §1 DiskHigh).'
          description_ru: 'Диск ноды выше warning-порога (ops.md §1 DiskHigh).'

      - alert: DiskHighCritical
        expr: 100 * birdman_agent_disk_used_bytes / birdman_agent_disk_total_bytes > {{ birdman_disk_crit_pct }}
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'DiskHigh(crit): диск агента ({{ $labels.node }}) {{ $value }}%'{% endraw %}

          description: 'Node disk usage is above the critical threshold — GC/prune/add disk (ops.md §6 runbook 4).'
          description_ru: 'Диск ноды выше critical-порога — GC/прюнинг/докупить диск (ops.md §6 runbook 4).'

      # DiskHigh (containerd-ФС образов): зеркало пары выше по dual-fs watermark
      # (agent.md §6, environments v1 §6в). Образы дедиков живут под containerd_root
      # — возможно ОТДЕЛЬНЫЙ маунт от data_dir; отдельная пара по
      # birdman_agent_containerd_disk_* с ТЕМИ ЖЕ порогами/for. На одной ФС
      # (containerd_root == маунт data_dir) обе пары показывают один процент и
      # дублируют друг друга — приемлемо (alertmanager дедупит по severity+node);
      # на раздельных маунтах эта пара — единственный сигнал по ФС образов.
      - alert: ContainerdDiskHighWarning
        expr: 100 * birdman_agent_containerd_disk_used_bytes / birdman_agent_containerd_disk_total_bytes > {{ birdman_disk_warn_pct }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'DiskHigh(warn): containerd-ФС образов ({{ $labels.node }}) {{ $value }}%'{% endraw %}

          description: 'Node containerd filesystem (images) is above the warning threshold (ops.md §1 DiskHigh).'
          description_ru: 'containerd-ФС (образы) ноды выше warning-порога (ops.md §1 DiskHigh).'

      - alert: ContainerdDiskHighCritical
        expr: 100 * birdman_agent_containerd_disk_used_bytes / birdman_agent_containerd_disk_total_bytes > {{ birdman_disk_crit_pct }}
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'DiskHigh(crit): containerd-ФС образов ({{ $labels.node }}) {{ $value }}%'{% endraw %}

          description: 'Node containerd filesystem (images) is above the critical threshold — GC/prune/add disk (ops.md §6 runbook 4).'
          description_ru: 'containerd-ФС (образы) ноды выше critical-порога — GC/прюнинг/докупить диск (ops.md §6 runbook 4).'

      # AllocationFailures: любые провалы аллокации (по reason и project — лейбл
      # project метрика несёт с master'а, expr его не трогает; см. BufferEmptyAllocFail).
      - alert: AllocationFailures
        expr: increase(birdman_allocation_failures_total[5m]) > 0
        for: 0s
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'AllocationFailures: проект {{ $labels.project }}, reason={{ $labels.reason }} за 5м: {{ $value }}'{% endraw %}

          description: 'Allocation failures are increasing (ops.md §1 AllocationFailures).'
          description_ru: 'Растут ошибки аллокации (ops.md §1 AllocationFailures).'

      # TickDegraded: тик игрового сервера выше порога игры дольше 5м.
      # (ops.md §1 говорит про p95 tick_ms; в v0 agent отдаёт gauge
      #  birdman_server_tick_ms{server_id} — правило на него, порог — var.)
      #
      # ПРОЕКТНЫЙ ЧЕРЕЗ JOIN (tracker #958). Деградировавший тик — проблема
      # конкретной игры, но спроецировать проект было нечем: метрику эмитит
      # АГЕНТ, а агент проекта дедика не знает вовсе (StartServer ему проект не
      # везёт). Лейбл, отчеканенный агентом, потребовал бы правки агента +
      # апгрейда всего флота + полной перекрутки живых дедиков (Restore
      # поднимает состояние из label'ов контейнера, проекта там нет) — то есть
      # выката. Вместо этого master эмитит справочную серию
      # birdman_server_info{server_id, project, env} = 1 из БД
      # (master/internal/metrics/metrics.go, collectServerInfo), а правило
      # доклеивает лейбл join'ом — работает на всём существующем флоте со
      # следующего скрейпа, без единого выката.
      #
      # ДВЕ ВЕТКИ, потому что join обязан быть НЕ СКРЫВАЮЩИМ:
      #   1) сматчилось → алерт несёт project и становится проектным по идиоме
      #      #955 (область выводится из НАЛИЧИЯ лейбла, никакого scope: в
      #      правиле — чужие правила self-host-операторов работают как работали);
      #   2) не сматчилось (master лежит, БД моргнула, дедика нет в БД) →
      #      алерт всё равно ГОРИТ, просто без лейбла, т.е. платформенным, и
      #      виден при любом ?project= (не-скрывающий фильтр master.md §6).
      #      Деградация РАСШИРЯЕТ алерт, а не роняет его. Ровно этот случай
      #      закреплён кейсом в tests/rules_test.yml — молчаливо не сматчиться
      #      join уже не может.
      # $value не портится: info == 1, умножение оставляет tick как есть.
      # `unless on (server_id)` делает ветки непересекающимися → один дедик
      # никогда не даёт двух алертов.
      # `max by (server_id, project)` — страховка от many-to-one: два master'а
      # (или два скрейп-джоба одного) дали бы ДВЕ info-серии на один server_id,
      # и весь запрос свалился бы в ошибку «multiple matches» — правило умерло
      # бы целиком, худший вид «молча не работает». Агрегация схлопывает их в
      # одну, join остаётся однозначным.
      - alert: TickDegraded
        expr: >-
          (birdman_server_tick_ms > {{ birdman_tick_degraded_ms }})
          * on (server_id) group_left (project)
          max by (server_id, project) (birdman_server_info)
          or
          (birdman_server_tick_ms > {{ birdman_tick_degraded_ms }})
          unless on (server_id) birdman_server_info
        for: {{ birdman_tick_degraded_for }}
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'TickDegraded: {{ if $labels.project }}проект {{ $labels.project }}, {{ end }}server {{ $labels.server_id }} tick={{ $value }}ms'{% endraw %}

          description: 'game-health: server tick has been degraded for longer than the threshold (ops.md §1 TickDegraded). The project label is joined from birdman_server_info; without a match the alert stays platform-scoped.'
          description_ru: 'game-health: тик деградировал дольше порога (ops.md §1 TickDegraded). Лейбл project доклеивается join''ом с birdman_server_info; без совпадения алерт остаётся платформенным.'

      # AgentUpgradeFailed: self-upgrade агента не завершился Hello с новой
      # версией в окне (master пишет событие agent_upgrade_failed, итерация 4).
      # Нулевая база вида — как у CrashLoop выше (первое событие видно, #960).
      - alert: AgentUpgradeFailed
        expr: increase(birdman_events_total{kind="agent_upgrade_failed"}[10m]) > 0
        for: 0s
        labels:
          severity: critical
        annotations:
          summary: {% raw %}'AgentUpgradeFailed: неудачных апгрейдов агента за 10м: {{ $value }}'{% endraw %}

          description: 'Agent did not come back online with the new version (agent.md §7; rollback via ansible).'
          description_ru: 'Агент не вышел на связь с новой версией (agent.md §7; откат — ansible).'

      # CertExpiry (mTLS agentlink v1, дизайн §3/§4): любой серт линка близок к
      # истечению. Три источника метрик:
      #   birdman_tls_cert_expiry_timestamp_seconds{cert="ca|server"} — master (БД),
      #   birdman_node_cert_expiry_timestamp_seconds{node}            — master (БД),
      #   birdman_agent_cert_expiry_timestamp_seconds                 — агент (локально).
      # $value = секунд до истечения (отрицательное → серт уже просрочен). Серии
      # без серта не экспортируют (absent → не стреляет). Порог expr — окно
      # renewal (14д). НО renewal-тикер агента/master — 24ч, поэтому здоровый
      # серт законно проводит <14д-до-истечения до ~24ч каждый цикл, пока не
      # ротируется — при коротком for: это давало бы ложный алерт ~каждый цикл.
      # Отсюда for:25h (порог 14д НЕ трогаем): горит, только если пропущен ЦЕЛЫЙ
      # цикл renewal (24ч + 1ч запас) → ротация реально застряла; до фактического
      # истечения тогда ещё ~12.9д.
      - alert: CertExpiry
        expr: >-
          (birdman_tls_cert_expiry_timestamp_seconds - time()) < {{ birdman_cert_expiry_warn_seconds }}
          or (birdman_node_cert_expiry_timestamp_seconds - time()) < {{ birdman_cert_expiry_warn_seconds }}
          or (birdman_agent_cert_expiry_timestamp_seconds - time()) < {{ birdman_cert_expiry_warn_seconds }}
        for: 25h
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'CertExpiry: {{ $labels.instance }} {{ $labels.cert }}{{ $labels.node }} — истекает через {{ $value | humanizeDuration }}'{% endraw %}

          description: 'An mTLS agentlink cert (master CA/server cert, node cert, agent-side view) expires in less than the threshold (ops.md §1 CertExpiry). Check enrollment/renewal and CA rotation.'
          description_ru: 'Серт mTLS-agentlink (CA/сервер master, серт ноды, взгляд агента) истекает < порога (ops.md §1 CertExpiry). Проверь enrollment/renewal и ротацию CA.'

      # Backups v1 (spec 2026-07-13): Stale — страховка «тихо перестал ходить»
      # (метрика деривится из БД и отдаёт 0, если успехов не было вовсе);
      # Failed — быстрый сигнал по свежей ошибке прогона.
      - alert: BackupStale
        expr: birdman_backup_enabled == 1 and (time() - birdman_backup_last_success_timestamp_seconds) > 2 * birdman_backup_interval_seconds
        for: {{ birdman_backup_stale_for }}
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'BackupStale: последний успешный бекап старше 2×интервала'{% endraw %}

          description: 'The last successful backup is older than 2× the interval — the master backup scheduler is not producing successes (ops.md §5, Backups v1).'
          description_ru: 'Планировщик бекапов master не приносит успехов (ops.md §5, Backups v1).'

      - alert: BackupFailed
        expr: birdman_backup_last_error_timestamp_seconds > 0 and (time() - birdman_backup_last_error_timestamp_seconds) < 3600
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'BackupFailed: прогон бекапа падал за последний час'{% endraw %}

          description: 'A backup run failed within the last hour — see Admin → Backups (history with the error text) and the backup_failed event. Keeps firing until an hour has passed since the error — by design (a rotation-immune gauge instead of increase over the non-monotonic runs_total).'
          description_ru: 'Смотри Админку → Бекапы (история с текстом ошибки) и событие backup_failed. Горит до истечения часа после ошибки — осознанно (rotation-immune гейдж вместо increase по немонотонному runs_total).'

      # Дев-стенд v2 (spec 2026-08-10): pull-деплоер. Failed — была битая
      # сборка и откат; Stale — тики идут, но успеха нет (типично: каждый тик
      # падает на скачивании). Разведены намеренно: «релиз недоступен» не
      # трогает ни один из таймстемпов, поэтому поднимает только Stale, а
      # ложную тревогу о битой сборке — нет.
      - alert: DevDeployFailed
        expr: birdman_devdeploy_last_failure_timestamp > birdman_devdeploy_last_success_timestamp
        for: {{ birdman_devdeploy_failed_for }}
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'DevDeployFailed: авто-выкат дев-стенда упал и откатился'{% endraw %}

          description: 'The dev-stand pull deployer rejected a build: either the sha256 did not match or the master failed its /healthz gate and was rolled back to the previous binary. The bad artifact is recorded in /var/lib/birdman-master/rejected and will not be retried — the next main build supersedes it. See `journalctl -u birdman-devdeploy`.'
          description_ru: 'Деплоер отверг сборку: не сошлась sha256 либо мастер не прошёл /healthz и откачен на предыдущий бинарь. Артефакт записан в /var/lib/birdman-master/rejected и повторяться не будет — его вытеснит следующая сборка из main. Смотри `journalctl -u birdman-devdeploy`.'

      - alert: DevDeployAgentsBehind
        expr: birdman_devdeploy_agents_behind > 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'DevDeployAgentsBehind: агенты dev-окружения отстали от целевой версии'{% endraw %}

          description: 'One or more live dev-environment nodes have not reached the target agent version for half an hour. This is drift by fact, whatever the cause: the registry not handing out a signed link, the version parked in /var/lib/birdman-master/rejected after a canary failure, or a chain that never finished. The master deploy itself keeps succeeding, so neither DevDeployFailed nor DevDeployStale covers this. See `journalctl -u birdman-devdeploy`.'
          description_ru: 'Одна или несколько живых нод dev-окружения полчаса не доходят до целевой версии агента. Это дрейф по факту, какой бы ни была причина: реестр не отдаёт подписанную ссылку, версия лежит в /var/lib/birdman-master/rejected после провала канарейки, цепочка не довершилась. Выкат мастера при этом успешен, поэтому ни DevDeployFailed, ни DevDeployStale такого не покажут. Смотри `journalctl -u birdman-devdeploy`.'

      - alert: DevDeployStale
        expr: birdman_devdeploy_last_success_timestamp > 0 and (time() - birdman_devdeploy_last_success_timestamp) > {{ birdman_devdeploy_stale_after_h }} * 3600
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: {% raw %}'DevDeployStale: успешного тика авто-выката не было дольше порога'{% endraw %}

          description: 'The deployer timer is alive but no tick has succeeded for hours — typically the release is unreachable (network, deleted tag, renamed asset). A quiet no-op also counts as success, so weekends without commits do NOT trigger this.'
          description_ru: 'Таймер жив, но успешных тиков нет часами — обычно недоступен релиз (сеть, снесённый тег, переименованный ассет). Тихий no-op тоже считается успехом, поэтому выходные без коммитов это правило НЕ поднимают.'

