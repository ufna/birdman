# {{ ansible_managed }}
# env_file для Grafana (0600). Пароль admin — из birdman_grafana_admin_password_file
# (сгенерирован ansible'ом, живёт только на тачке). НЕ коммитить.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ birdman_grafana_admin_password }}
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SERVER_HTTP_PORT={{ birdman_grafana_port }}
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_LOG_LEVEL=warn
