# {{ ansible_managed }}
# Ротация истории алертов (tracker #1073). До неё у файла не было потолка
# ВООБЩЕ: за два часа 10-11.08, пока vmalert постил в sink напрямую каждые 5с
# без группировки, {{ birdman_alerts_log }} налился на 498 МБ (~250 МБ/час), и
# записи про birdman в /etc/logrotate.d/ не было ни одной.
#
# ПО РАЗМЕРУ, А НЕ DAILY — это решение, а не умолчание. История панели
# ограничена ТЕКУЩИМ файлом (master читает один путь, docs/specs/master.md §6),
# поэтому daily обнуляла бы её каждые сутки. При сегодняшнем темпе (alertmanager
# группирует, repeat_interval 1h — килобайты в сутки) порог не достигается
# практически никогда: история остаётся полной, а порог работает страховкой от
# повтора того самого доальтертменеджерного темпа.
#
# БЕЗ copytruncate И БЕЗ delaycompress — тоже намеренно: alert-logger.py
# открывает файл на КАЖДУЮ запись (`with open(LOG_PATH, "a")`) и fd между
# запросами не держит, поэтому обычный rename+create ничего не теряет и sink
# перезапускать не нужно. Свойство закреплено тестом роли
# (tests/rotation_in_container.sh): заведись у sink'а долгоживущий fd, ротация
# начала бы молча писать в удалённый inode, то есть терять каждый алерт.
{{ birdman_alerts_log }} {
    size {{ birdman_alerts_log_rotate_size }}
    rotate {{ birdman_alerts_log_rotate_keep }}
    compress
    missingok
    notifempty
    create 0644 root root
}
