# {{ ansible_managed }}
# Конфиг birdman-master (docs/specs/master.md §7, дев-дефолты v0).
# Файл 0600: DSN содержит пароль Postgres.

dsn: "postgres://postgres:{{ birdman_pg_password }}@127.0.0.1:{{ birdman_master_pg_port }}/birdman?sslmode=disable"

# Мастер-ключ шифрования обратимых секретов at-rest (registries.token,
# internal_ca.key_pem — secrets-encryption §2). Файл 0600 на боксе,
# провижинится этой ролью; master без него не стартует (fail-loud).
secrets_key_file: "{{ birdman_master_secrets_key_file }}"

# Только localhost: наружу master на дев-боксе не выставляется.
listen_api: "{{ birdman_master_api_addr }}"
listen_grpc: "{{ birdman_master_grpc_addr }}"

tls:
  # Пусто → master выпускает себе server-лист от внутренней CA (в PG) при
  # каждом старте (mTLS agentlink v1, дизайн §1). auto_cert_dir оставлен
  # принятым, но неиспользуемым — self-signed автоген выведен из эксплуатации.
  cert_file: ""
  key_file: ""
  auto_cert_dir: "{{ birdman_master_data_dir }}/certs"

# Режим аутентификации agentlink-листенера: token|mixed|mtls (mTLS v1, §6).
agentlink_auth: "{{ birdman_agentlink_auth | default('mixed') }}"

# Quarantine дольше N минут → down + событие node_down (heartbeat живой сессии
# вернёт в active; dead — только ручная ревокация, не отсюда). Минуты, >= 1.
node_down_after_min: {{ birdman_node_down_after_min }}
