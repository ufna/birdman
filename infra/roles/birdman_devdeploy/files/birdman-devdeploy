#!/usr/bin/env bash
# birdman-devdeploy — pull-деплоер дев-стенда.
#
# Раз в тик: сходить за дев-сборкой, сверить sha256 с тем, что установлено,
# поставить, перезапустить мастера и убедиться по /healthz, что он поднялся.
# Не поднялся — вернуть предыдущий бинарь и запомнить sha как отвергнутый,
# чтобы не катать битую сборку по кругу (та же семантика, что у auto_deploy
# версий: упавшая версия не ретраится, её вытеснит следующий билд).
#
# Артефакты живут OCI-артефактом в GHCR-пакете (`ghcr.io/<owner>/birdman-dev`,
# подвижный тег `dev`), а НЕ релизами GitHub: релиз — это обещание
# пользователям, а здесь чистый дев-стейт, и публичный репозиторий не должен им
# обрастать (решение владельца 11.08.2026).
#
# Почему pull, а не push из CI: репозиторий публичный, и push означал бы ключ к
# инфраструктуре в его настройках. Здесь бокс ходит наружу сам, только по HTTPS,
# и ничего не открывает.
#
# Спека: birdman-internal/docs/superpowers/specs/2026-08-10-devnode-tc-and-dev-autodeploy-design.md
#
# set -e намеренно НЕ включён: отказы разбираются явно, тихий no-op — норма.
set -uo pipefail

CONF="${BIRDMAN_DEVDEPLOY_CONF:-/etc/birdman/devdeploy.conf}"
# Конфиг присваивает через `: "${VAR:=…}"`, поэтому переменные окружения
# (тесты, ручной прогон) всегда сильнее файла.
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

REGISTRY="${BIRDMAN_DEVDEPLOY_REGISTRY:-ghcr.io}"
PACKAGE="${BIRDMAN_DEVDEPLOY_PACKAGE:-ufna/birdman-dev}"
TAG="${BIRDMAN_DEVDEPLOY_TAG:-dev}"
REG_BASE="${BIRDMAN_DEVDEPLOY_REG_BASE:-https://$REGISTRY/v2/$PACKAGE}"
TOKEN_URL="${BIRDMAN_DEVDEPLOY_TOKEN_URL:-https://$REGISTRY/token?scope=repository:$PACKAGE:pull&service=$REGISTRY}"
BIN="${BIRDMAN_DEVDEPLOY_BIN:-/usr/local/bin/birdman-master}"
SERVICE="${BIRDMAN_DEVDEPLOY_SERVICE:-birdman-master}"
STATE_DIR="${BIRDMAN_DEVDEPLOY_STATE_DIR:-/var/lib/birdman-master}"
LOCK="${BIRDMAN_DEVDEPLOY_LOCK:-/run/birdman/devdeploy.lock}"
DISABLED="${BIRDMAN_DEVDEPLOY_DISABLED:-/etc/birdman/devdeploy.disabled}"
MASTER_API="${BIRDMAN_DEVDEPLOY_MASTER_API:-http://127.0.0.1:8100}"
ADMIN_KEY_FILE="${BIRDMAN_DEVDEPLOY_ADMIN_KEY_FILE:-/etc/birdman/master-admin.key}"
HEALTH_TIMEOUT="${BIRDMAN_DEVDEPLOY_HEALTH_TIMEOUT:-60}"
AGENT_TIMEOUT="${BIRDMAN_DEVDEPLOY_AGENT_TIMEOUT:-90}"
POLL="${BIRDMAN_DEVDEPLOY_POLL_INTERVAL:-2}"
TEXTFILE_DIR="${BIRDMAN_DEVDEPLOY_TEXTFILE_DIR:-/var/lib/node_exporter/textfile_collector}"
SKIP_AGENTS="${BIRDMAN_DEVDEPLOY_SKIP_AGENTS:-}"
# Окружение, чьи агенты обновляются. Прод сюда не попадает никогда: цели
# перечисляются явно и фильтруются по этому имени.
DEV_ENV="${BIRDMAN_DEVDEPLOY_ENV:-dev}"
ADMIN_KEY=""

REJECTED="$STATE_DIR/rejected"
DEPLOYED="$STATE_DIR/deployed.json"
METRICS="$STATE_DIR/metrics.env"
PROM="$TEXTFILE_DIR/birdman-devdeploy.prom"

# Пишем в stderr, а НЕ в stdout. Семь функций ниже вызываются через $( )
# (manifest_json, blob_digest, blob_fetch, blob_url, agent_targets,
# node_agent_version, json_get), и строка лога из любой из них молча уехала бы в
# ВОЗВРАЩАЕМОЕ ЗНАЧЕНИЕ — так уже случилось с фоллбэком blob_url, агент получил
# лог вместо URL. Потребителей у log-в-stdout нет: юнит oneshot, journald пишет
# оба потока, тестовый харнесс ловит 2>&1.
log() { printf '%s birdman-devdeploy: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# sha256 переносимо: Linux — sha256sum, macOS (прогон тестов) — shasum.
if command -v sha256sum >/dev/null 2>&1; then
  sha_of() { sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
else
  sha_of() { shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'; }
fi

# --- OCI-реестр как транспорт артефактов -------------------------------------
#
# Пакет ПУБЛИЧНЫЙ, но реестр по спеке всё равно требует Bearer: pull-токен
# выдаётся кому угодно и без учётной записи — секретов на боксе не появляется,
# модель «бокс ходит наружу сам» сохраняется целиком.
#
# -L обязателен на блобах: реестр отвечает 307 на подписанный URL в
# pkg-containers.githubusercontent.com; без него curl вернёт пустое тело.

json_get() { # <ключ> — значение поля верхнего уровня из JSON на stdin
  python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
print(d.get(sys.argv[1], ""))
' "$1" 2>/dev/null
}

# Токен живёт минуты, а тик с ожиданием агентов может пережить исходный —
# поэтому кэш с коротким TTL, а не один токен на весь прогон.
#
# Функция НЕ печатает токен и вызывается БЕЗ подстановки: `t="$(reg_token)"`
# выполнил бы её в подоболочке, и присваивания REG_TOKEN/REG_TOKEN_AT не
# вернулись бы в родителя — кэш существовал бы только в комментарии, а токен
# перезапрашивался бы на каждый блоб.
REG_TOKEN=""
REG_TOKEN_AT=0
reg_token_ensure() {
  local now
  now="$(date +%s)"
  if [ -n "$REG_TOKEN" ] && [ "$((now - REG_TOKEN_AT))" -lt 120 ]; then
    return 0
  fi
  REG_TOKEN="$(curl -fsS --max-time 30 "$TOKEN_URL" | json_get token)"
  [ -n "$REG_TOKEN" ] || return 1
  REG_TOKEN_AT="$now"
}

manifest_json() {
  reg_token_ensure || return 1
  local t="$REG_TOKEN"
  curl -fsS --max-time 30 -H "Authorization: Bearer $t" \
    -H "Accept: application/vnd.oci.image.manifest.v1+json" \
    "$REG_BASE/manifests/$TAG"
}

# blob_digest <manifest-json> <имя-файла> — digest блоба по title-аннотации.
# Digest блоба И ЕСТЬ sha256 файла (oras кладёт каждый файл отдельным блобом),
# поэтому отдельные .sha256-ассеты больше не нужны: целостность сверяется с
# именем содержимого, а не с рядом лежащей строкой.
blob_digest() {
  printf '%s' "$1" | python3 -c '
import sys, json
title = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for layer in d.get("layers", []):
    if (layer.get("annotations") or {}).get("org.opencontainers.image.title") == title:
        print(layer.get("digest", ""))
        break
' "$2" 2>/dev/null
}

blob_fetch() { # <digest> [выходной-файл] — тело в stdout либо в файл
  local digest="$1" out="${2:-}" t
  reg_token_ensure || return 1
  t="$REG_TOKEN"
  if [ -n "$out" ]; then
    curl -fsSL --max-time 120 -H "Authorization: Bearer $t" -o "$out" "$REG_BASE/blobs/$digest"
  else
    curl -fsSL --max-time 30 -H "Authorization: Bearer $t" "$REG_BASE/blobs/$digest"
  fi
}

# blob_url <digest> — подписанный URL блоба, который качается БЕЗ заголовков.
# Нужен шагу агентов: агент тянет свой бинарь сам, обычным GET, и Bearer'а не
# умеет (agent/internal/daemon/manager.go: applyUpgrade). Ссылка живёт минуты,
# поэтому резолвится непосредственно перед командой конкретной ноде.
blob_url() {
  local digest="$1" t url
  reg_token_ensure || return 1
  t="$REG_TOKEN"
  local rc
  url="$(curl -fsS --max-time 30 -o /dev/null -w '%{redirect_url}' \
    -H "Authorization: Bearer $t" "$REG_BASE/blobs/$digest")"
  rc=$?
  # РАЗЛИЧАЕМ ДВА СЛУЧАЯ ПО КОДУ ВОЗВРАТА, а не по пустоте строки — они дают
  # одинаково пустой url, но требуют противоположного поведения:
  #
  #   rc=0  — реестр ответил, просто без 307 (200 телом). Ссылка на блоб рабочая,
  #           отдаём её: шаг агентов не должен вставать из-за формы ответа.
  #   rc≠0  — реестр НЕ ответил (сеть, 5xx под -f, таймаут). Отдать тут прямую
  #           ссылку значило бы послать агенту заведомо нерабочий адрес: он не
  #           скачает, не перепредставится, словит таймаут — и исправная сборка
  #           уедет в rejected НАВСЕГДА. Транзиентный сбой сети не имеет права
  #           отвергать сборку: возвращаем ошибку, вызывающий отложит шаг.
  if [ "$rc" -ne 0 ]; then
    return 1
  fi
  if [ -n "$url" ]; then
    printf '%s' "$url"
    return 0
  fi
  log "реестр отдал блоб без редиректа — агенту уходит прямая ссылка"
  printf '%s' "$REG_BASE/blobs/$digest"
}

# --- метрики (textfile-коллектор node_exporter) ------------------------------
M_SUCCESS=0
M_FAILURE=0
M_ROLLBACKS=0
M_AGENT_OK=0
M_AGENT_FAIL=0
# Сколько живых нод dev-окружения ещё не на целевой версии агента. Гейдж, а не
# счётчик: он показывает ДРЕЙФ по факту, каким бы ни была его причина —
# осечка реестра, версия в rejected после провала канарейки, зависшая цепочка.
# Отдельные счётчики на каждую ветку отказа этого не давали: шаг агентов мог
# тихо не состояться, а last_success при этом обновлялся шагом мастера, и ни
# DevDeployFailed, ни DevDeployStale не загорались бы.
M_AGENTS_BEHIND=0

load_metrics() {
  # shellcheck source=/dev/null
  [ -r "$METRICS" ] && . "$METRICS"
  return 0
}

save_metrics() {
  mkdir -p "$STATE_DIR"
  cat >"$METRICS.tmp" <<EOF
M_SUCCESS=$M_SUCCESS
M_FAILURE=$M_FAILURE
M_ROLLBACKS=$M_ROLLBACKS
M_AGENT_OK=$M_AGENT_OK
M_AGENT_FAIL=$M_AGENT_FAIL
M_AGENTS_BEHIND=$M_AGENTS_BEHIND
EOF
  mv "$METRICS.tmp" "$METRICS"

  # Пишем атомарно: node_exporter читает каталог в любой момент, а
  # наполовину записанный файл он отверг бы целиком.
  [ -d "$TEXTFILE_DIR" ] || return 0
  cat >"$PROM.tmp" <<EOF
# HELP birdman_devdeploy_last_success_timestamp Unixtime последнего успешного тика авто-выката.
# TYPE birdman_devdeploy_last_success_timestamp gauge
birdman_devdeploy_last_success_timestamp $M_SUCCESS
# HELP birdman_devdeploy_last_failure_timestamp Unixtime последнего отказа авто-выката.
# TYPE birdman_devdeploy_last_failure_timestamp gauge
birdman_devdeploy_last_failure_timestamp $M_FAILURE
# HELP birdman_devdeploy_rollbacks_total Сколько раз мастер откатывался на предыдущий бинарь.
# TYPE birdman_devdeploy_rollbacks_total counter
birdman_devdeploy_rollbacks_total $M_ROLLBACKS
# HELP birdman_devdeploy_agent_upgrades_total Апгрейды агентов dev-окружения по исходу.
# TYPE birdman_devdeploy_agent_upgrades_total counter
birdman_devdeploy_agent_upgrades_total{status="ok"} $M_AGENT_OK
birdman_devdeploy_agent_upgrades_total{status="failed"} $M_AGENT_FAIL
# HELP birdman_devdeploy_agents_behind Живые ноды dev-окружения, не дошедшие до целевой версии агента.
# TYPE birdman_devdeploy_agents_behind gauge
birdman_devdeploy_agents_behind $M_AGENTS_BEHIND
EOF
  mv "$PROM.tmp" "$PROM"
}

# --- список отвергнутых артефактов -------------------------------------------
# Строки с префиксом: `master:<sha256>` и `agent:<version>`. Раздельно, чтобы
# провал агента не блокировал выкат мастера и наоборот.
rejected_has() { [ -f "$REJECTED" ] && grep -qxF "$1" "$REJECTED"; }
rejected_add() {
  mkdir -p "$STATE_DIR"
  rejected_has "$1" || printf '%s\n' "$1" >>"$REJECTED"
}

# --- лок ---------------------------------------------------------------------
# mkdir атомарен и есть везде (flock — util-linux, на macOS его нет, а тесты
# гоняются и там). Стухший лок старше 30 минут забираем: тик — oneshot, столько
# он не живёт даже с самым долгим health-gate.
acquire_lock() {
  mkdir -p "$(dirname "$LOCK")" 2>/dev/null
  if mkdir "$LOCK" 2>/dev/null; then
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    return 0
  fi
  if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin -30 2>/dev/null)" ]; then
    log "забираю стухший лок $LOCK"
    rmdir "$LOCK" 2>/dev/null
    if mkdir "$LOCK" 2>/dev/null; then
      trap 'rmdir "$LOCK" 2>/dev/null' EXIT
      return 0
    fi
  fi
  return 1
}

# --- health-gate -------------------------------------------------------------
# /healthz пингует БД, поэтому 200 status:ok означает «процесс поднялся,
# миграции прошли, БД жива» — ровно тот гейт, который нужен.
health_wait() {
  local deadline=$(($(date +%s) + HEALTH_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if curl -fsS --max-time 5 "$MASTER_API/healthz" 2>/dev/null | grep -q '"status":"ok"'; then
      return 0
    fi
    sleep "$POLL"
  done
  return 1
}

# --- шаг мастера -------------------------------------------------------------
# Коды: 0 выкачено · 1 нечего делать · 2 артефакт недоступен · 3 sha не сошлась
#       4 откат после провала health-gate
deploy_master() {
  local mf digest want have tmp got
  mf="$(manifest_json)"
  digest="$(blob_digest "$mf" birdman-master)"
  want="${digest#sha256:}"
  if [ "${#want}" -ne 64 ]; then
    log "артефакт $PACKAGE:$TAG недоступен или не несёт birdman-master — пропускаю тик"
    return 2
  fi

  have="$(sha_of "$BIN")"
  if [ "$want" = "$have" ]; then
    return 1
  fi
  if rejected_has "master:$want"; then
    log "сборка мастера $want уже отвергнута — не ретраю"
    return 1
  fi

  tmp="$(mktemp)"
  if ! blob_fetch "$digest" "$tmp"; then
    log "не смог скачать бинарь мастера"
    rm -f "$tmp"
    return 2
  fi
  got="$(sha_of "$tmp")"
  if [ "$got" != "$want" ]; then
    log "sha256 не сошлась: жду $want, получил $got — бинарь не тронут"
    rm -f "$tmp"
    return 3
  fi

  local manifest_txt commit agent_version
  manifest_txt="$(blob_fetch "$(blob_digest "$mf" MANIFEST)")"
  commit="$(printf '%s\n' "$manifest_txt" | awk -F= '/^commit=/{print $2}')"
  agent_version="$(printf '%s\n' "$manifest_txt" | awk -F= '/^agent_version=/{print $2}')"

  log "ставлю мастера $want (commit ${commit:-?})"
  [ -f "$BIN" ] && cp -p "$BIN" "$BIN.prev"
  install -m 0755 "$tmp" "$BIN"
  rm -f "$tmp"
  systemctl restart "$SERVICE"

  if health_wait; then
    mkdir -p "$STATE_DIR"
    cat >"$DEPLOYED" <<EOF
{"master_sha256":"$want","commit":"$commit","agent_version":"$agent_version","at":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
EOF
    log "мастер поднялся, /healthz ok"
    return 0
  fi

  log "health-gate не прошёл — откатываюсь на .prev"
  if [ -f "$BIN.prev" ]; then
    install -m 0755 "$BIN.prev" "$BIN"
    systemctl restart "$SERVICE"
    health_wait || log "ВНИМАНИЕ: после отката мастер тоже не поднялся"
  else
    log "ВНИМАНИЕ: .prev нет, откатывать нечем"
  fi
  rejected_add "master:$want"
  return 4
}

# --- шаг агентов -------------------------------------------------------------
#
# Три решения, каждое закрывает конкретную мину:
#
# 1. node_id ВСЕГДА явный. Форма POST /v1/agent-upgrade без node_id бьёт по
#    ВСЕМУ флоту и по коду не сужается ни по проекту, ни по окружению
#    (httpapi/ops.go: «апгрейд агента — инфраструктурная операция»).
#    Автоматический дев-пайплайн, способный разослать бинарь на все ноды
#    платформы, включая будущие прод-овые, недопустим — поэтому цели
#    перечисляем сами и фильтруем по env.
# 2. Канарейка — локальный агент master-бокса. У агента нет авто-отката:
#    упавший бинарь = офлайн-нода до ручного вмешательства. Первым идёт тот
#    агент, до которого мы дотягиваемся тривиально; лёг — удалённых не трогаем.
# 3. По одной, с гейтом по AgentVersion из re-Hello — тот же критерий, что у
#    watchdog'а мастера, а не «отправили и забыли».
#
# Безопасно это без единой строчки нового кода в агенте: команда идемпотентна
# (version == running → no-op), битая закачка не трогает бинарь, а контейнеры
# дедиков переживают рестарт агента — живые матчи не рвутся.

nodes_json() {
  curl -fsS --max-time 15 -H "Authorization: Bearer $ADMIN_KEY" \
    "$MASTER_API/v1/nodes?env=$DEV_ENV" 2>/dev/null
}

# node_agent_version <node_id> — версия агента ноды по данным мастера.
node_agent_version() {
  nodes_json | python3 -c '
import json, sys
want = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for n in d.get("nodes", []):
    if n.get("id") == want:
        print(n.get("agent_version", ""))
        break
' "$1"
}

# agent_targets <target-version> <local-hostname> — «id<TAB>hostname» на строку.
# Фильтр: только наш env, не dead, версия ещё не целевая. Локальная нода —
# первой (канарейка).
agent_targets() {
  nodes_json | python3 -c '
import json, sys
target, local, env = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
rows = [
    n for n in d.get("nodes", [])
    if n.get("env") == env
    and n.get("state") != "dead"
    and n.get("agent_version") != target
]
rows.sort(key=lambda n: 0 if n.get("hostname") == local else 1)
for n in rows:
    print(n.get("id", "") + "\t" + n.get("hostname", ""))
' "$1" "$2" "$DEV_ENV"
}

# Пересчёт дрейфа в конце тика. Считает по тем же правилам, что и цепочка
# апгрейда (живые ноды нашего env, версия ≠ целевой), поэтому 0 означает
# «все дошли», а не «шаг отработал».
#
# Известный предел: если не читается admin-ключ, считать не из чего — гейдж
# замирает на прошлом значении (без мастера цепочка всё равно невозможна).
AGENT_TARGET_VERSION=""
AGENT_LOCAL_HOST=""
recount_agents_behind() {
  [ -n "$AGENT_TARGET_VERSION" ] || return 0
  [ -n "$ADMIN_KEY" ] || ADMIN_KEY="$(cat "$ADMIN_KEY_FILE" 2>/dev/null)"
  [ -n "$ADMIN_KEY" ] || return 0
  local host
  host="${AGENT_LOCAL_HOST:-${BIRDMAN_DEVDEPLOY_LOCAL_HOSTNAME:-$(hostname)}}"
  M_AGENTS_BEHIND="$(agent_targets "$AGENT_TARGET_VERSION" "$host" | grep -c '[^[:space:]]')"
}

wait_agent_version() {
  local node_id="$1" target="$2"
  local deadline=$(($(date +%s) + AGENT_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ "$(node_agent_version "$node_id")" = "$target" ] && return 0
    sleep "$POLL"
  done
  return 1
}

upgrade_agents() {
  # Целевая версия берётся из MANIFEST, а НЕ из результата шага мастера:
  # типичный тик — мастер уже актуален (no-op), и если бы версия приезжала
  # только вместе с выкатом, отставшие агенты не сошлись бы никогда.
  local mf target
  mf="$(manifest_json)"
  target="$(blob_fetch "$(blob_digest "$mf" MANIFEST)" | awk -F= '/^agent_version=/{print $2}' | tr -d ' \t\r\n')"
  [ -n "$target" ] || return 0
  # Запоминаем ДО всех ранних выходов: пересчёт дрейфа в конце тика обязан
  # видеть цель и когда версия отвергнута, и когда шаг оборвался на осечке.
  AGENT_TARGET_VERSION="$target"
  if rejected_has "agent:$target"; then
    return 0
  fi

  local adigest sha
  adigest="$(blob_digest "$mf" birdman-agent)"
  sha="${adigest#sha256:}"
  if [ "${#sha}" -ne 64 ]; then
    log "digest агента не читается — шаг агентов пропущен"
    return 1
  fi

  ADMIN_KEY="$(cat "$ADMIN_KEY_FILE" 2>/dev/null)"
  if [ -z "$ADMIN_KEY" ]; then
    log "admin-ключ не читается — шаг агентов пропущен"
    return 1
  fi

  local local_host targets
  local_host="${BIRDMAN_DEVDEPLOY_LOCAL_HOSTNAME:-$(hostname)}"
  AGENT_LOCAL_HOST="$local_host"
  targets="$(agent_targets "$target" "$local_host")"
  [ -n "$targets" ] || return 0

  local node_id hostname url
  while IFS="$(printf '\t')" read -r node_id hostname; do
    [ -n "$node_id" ] || continue

    # Подписанная ссылка резолвится ПЕРЕД каждой нодой, а не один раз на цикл:
    # она живёт минуты, а цепочка ждёт re-Hello каждой ноды до AGENT_TIMEOUT.
    url="$(blob_url "$adigest")"
    if [ -z "$url" ]; then
      # Инфраструктурный отказ, а НЕ плохая сборка: версию НЕ отвергаем —
      # следующий тик попробует снова.
      log "реестр не отдал подписанную ссылку на бинарь агента — шаг отложен"
      return 1
    fi

    log "апгрейд агента $hostname ($node_id) до $target"
    if ! curl -fsS --max-time 15 -X POST \
      -H "Authorization: Bearer $ADMIN_KEY" -H "Content-Type: application/json" \
      -d "{\"node_id\":\"$node_id\",\"url\":\"$url\",\"sha256\":\"$sha\",\"version\":\"$target\"}" \
      "$MASTER_API/v1/agent-upgrade" >/dev/null; then
      log "мастер не принял команду апгрейда для $hostname"
      rejected_add "agent:$target"
      M_AGENT_FAIL=$((M_AGENT_FAIL + 1))
      return 1
    fi

    if wait_agent_version "$node_id" "$target"; then
      log "агент $hostname на $target"
      M_AGENT_OK=$((M_AGENT_OK + 1))
      continue
    fi

    # Канарейка легла — дальше по цепочке не идём: удалённой ноде тот же
    # битый бинарь стоил бы офлайна до ручного вмешательства.
    log "агент $hostname не перепредставился с $target — СТОП, остальные ноды не трогаю"
    rejected_add "agent:$target"
    M_AGENT_FAIL=$((M_AGENT_FAIL + 1))
    return 1
  done <<EOF
$targets
EOF
  return 0
}

main() {
  if [ -e "$DISABLED" ]; then
    exit 0
  fi
  if ! acquire_lock; then
    log "предыдущий тик ещё идёт — выхожу"
    exit 0
  fi
  mkdir -p "$STATE_DIR"
  load_metrics

  deploy_master
  local rc=$?
  case "$rc" in
    0 | 1) M_SUCCESS="$(date +%s)" ;;
    3) M_FAILURE="$(date +%s)" ;;
    4)
      M_FAILURE="$(date +%s)"
      M_ROLLBACKS=$((M_ROLLBACKS + 1))
      ;;
    # 2 — релиз недоступен: не успех и не отказ выката. Тишину поймает
    # DevDeployStale, поднимать DevDeployFailed тут было бы ложной тревогой.
  esac

  if [ "$rc" -eq 0 ] || [ "$rc" -eq 1 ]; then
    if [ -z "$SKIP_AGENTS" ]; then
      upgrade_agents
      # Отдельно от результата шага: он мог оборваться на инфраструктурной
      # осечке, и именно тогда дрейф должен стать видимым.
      recount_agents_behind
    fi
  fi

  save_metrics
  exit 0
}

main "$@"
