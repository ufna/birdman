# {{ ansible_managed }}
# Нодовый vmagent (итерация 5.2): скрейпит ТОЛЬКО локальных агентов и пушит
# в центральный VM через оверлей. Лейблы node/region — чтобы DiskHigh/
# TickDegraded различали ноды (ops.md §1).
#
# По джобу на КАЖДУЮ ноду бокса (tracker #1065): у каждой свой порт /metrics,
# и без отдельного джоба вторая нода не собиралась бы вовсе, а её DiskHigh/
# TickDegraded молчали бы, выглядя как здоровье. Имя джоба несёт суффикс ноды,
# поэтому и `up == 0`, и цепочка absent_over_time мониторинг-роли (#1061)
# накрывают её сами.
global:
  scrape_interval: {{ birdman_node_vmagent_scrape_interval }}
scrape_configs:
{% for i in birdman_instances %}
  - job_name: birdman-agent{{ i.suffix }}
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:{{ i.metrics_port }}"]
        labels:
          node: "{{ inventory_hostname if not i.name else i.node_name }}"
          region: "{{ i.region }}"
{% endfor %}
