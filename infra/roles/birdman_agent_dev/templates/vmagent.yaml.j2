# {{ ansible_managed }}
# Нодовый vmagent (итерация 5.2): скрейпит ТОЛЬКО локального агента и пушит
# в центральный VM через оверлей. Лейблы node/region — чтобы DiskHigh/
# TickDegraded различали ноды (ops.md §1).
global:
  scrape_interval: {{ birdman_node_vmagent_scrape_interval }}
scrape_configs:
  - job_name: birdman-agent
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:9101"]
        labels:
          node: "{{ inventory_hostname }}"
          region: "{{ birdman_region }}"
