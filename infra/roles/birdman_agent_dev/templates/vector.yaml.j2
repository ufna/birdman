{% set log_roots = birdman_instances | map(attribute='log_dir') | map('regex_escape') | list %}
{% set root_re = log_roots[0] if log_roots | length == 1 else '(?:' ~ (log_roots | join('|')) ~ ')' %}
# {{ ansible_managed }}
# Шиппер логов дедиков → VictoriaLogs (централизованные логи; спека docs/specs/ops.md).
data_dir: /vector-data-dir
api:
  enabled: false
sources:
  dedik_logs:
    type: file
    # По паре глобов на КАЖДУЮ ноду бокса (tracker #1065): у каждой свой
    # log_dir, потому что фоновая уборка агента (logrot) архивирует всё, чего
    # нет в её списке живых серверов, и общий каталог означал бы порчу живых
    # логов соседа. Шиппер при этом один — он читает объединение.
    #
    # Размеченный путь (tracker #994): агент кладёт вывод дедика в
    # {project}/{env}/{server_id}.log, и пара едет в стрим-лейблы. Пара
    # приходит с ДЕДИКОМ (master → StartServer.env), а не с хостом: env ноды
    # меняется через API без перерендера этого файла, и инвариант I6
    # запрещает выводить окружение истории из текущей строки ноды.
    # Плоский путь — дедики, запущенные ДО разметки (и run-once). Их строки
    # шиппятся по-прежнему (логи флота не теряем), но без project/env, а
    # значит привязанному ключу master их не отдаёт — они доживают ретенцию.
    include:
{% for i in birdman_instances %}
      - "{{ i.log_dir }}/servers/*/*/*.log"
      - "{{ i.log_dir }}/servers/*.log"
{% endfor %}
    # .log.1 не читаем: его содержимое уже прочитано live до ротации
    exclude:
{% for i in birdman_instances %}
      - "{{ i.log_dir }}/servers/*/*/*.log.1"
      - "{{ i.log_dir }}/servers/*.log.1"
{% endfor %}
    read_from: beginning
    ignore_older_secs: 172800   # при первом старте не заливать древность
transforms:
  enrich:
    type: remap
    inputs: [dedik_logs]
    source: |
      # Разбор ПОЛНОГО пути, а не хвоста: якорь ^ плюс корень целиком не дают
      # плоскому {log_dir}/servers/{id}.log распасться на пару
      # project=birdman, env=servers — оба слова валидные слаги, и такая пара
      # отдала бы нелейблованную историю ключу, привязанному к ней.
      # Корней столько же, сколько нод у бокса (#1065), и каждый экранирован:
      # альтернатива перечисляет ИМЕННО их, а не «любой каталог в /var/log».
      parsed, err = parse_regex(string!(.file), r'^{{ root_re }}/servers/(?:(?P<project>[^/]+)/(?P<env>[^/]+)/)?(?P<id>[^/]+)\.log$')
      .server_id = if err == null { parsed.id } else { "unknown" }
      project = if err == null { string(parsed.project) ?? "" } else { "" }
      env = if err == null { string(parsed.env) ?? "" } else { "" }
      # Вторая петля на том же гвозде: лейблом становится только пара, которую
      # master вообще способен подставить в фильтр (алфавит слага проекта и
      # имени окружения). Каталог со странным именем оставит строку БЕЗ пары —
      # она просто не попадёт привязанному ключу, а не подменит чужую.
      ok = match(project, r'^[a-z0-9][a-z0-9-]{0,31}$') && match(env, r'^[a-z0-9][a-z0-9-]{0,31}$')
      .project = if ok { project } else { "" }
      .env = if ok { env } else { "" }
      .node = "{{ inventory_hostname }}"
      .region = "{{ birdman_region }}"
{% for i in birdman_instances if i.name %}
      # Строка из log_dir именованной ноды принадлежит ЕЙ, а не боксу: лейбл
      # node в этом стеке значит ноду birdman, и на многонодовом хосте имя
      # инвентаря было бы про неё враньём. Регион — оттуда же: он свойство
      # НОДЫ, и ноды одного бокса вольны стоять в разных регионах флота.
      if starts_with(string!(.file), "{{ i.log_dir }}/servers/") { .node = "{{ i.node_name }}"; .region = "{{ i.region }}" }
{% endfor %}
sinks:
  victorialogs:
    type: loki
    inputs: [enrich]
    endpoint: "{{ birdman_vl_sink_url }}"
    encoding:
      codec: text
{% raw %}
    labels:
      server_id: "{{ server_id }}"
      node: "{{ node }}"
      region: "{{ region }}"
      # Пара владельца строки. Это СТРИМ-поля, а не поля события: master сужает
      # запрос привязанного ключа через extra_stream_filters, то есть граница
      # доступа опирается на то, что проставил шиппер, а не на то, что дедик мог
      # напечатать в свой stdout.
      project: "{{ project }}"
      env: "{{ env }}"
{% endraw %}
    # Пин каденса флаша (= дефолту loki-sink, но явно): готовая строка уходит
    # в VL за ~1с, батч НЕ может держать хвост минутами. Наблюдавшиеся ~4м40с
    # (tracker #235) — выше синка: незавершённая строка без \n в file-source
    # (vector#18341, cio-чанк агента может разорвать строку), stdio-буфер
    # продьюсера или ретраи доставки. Пин фиксирует контракт и защищает от
    # дрейфа дефолта при апгрейдах vector.
    batch:
      timeout_secs: 1
    buffer:
      type: disk
      max_size: 268435488        # 256MB; переполнение — дропаем новое
      when_full: drop_newest
