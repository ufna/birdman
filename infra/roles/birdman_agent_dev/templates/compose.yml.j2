# {{ ansible_managed }}
# Vector — шиппер логов дедиков в центральный VictoriaLogs (агент здесь НЕ
# контейнер — статический бинарь под systemd, см. роль birdman_agent_dev).
# host-network: ничего не слушает (api.enabled: false), только читает
# локальные файлы логов и шлёт наружу loki-push.
#
# ОДИН шиппер на бокс и при нескольких нодах (tracker #1065): он монтирует
# log-каталог КАЖДОЙ ноды хоста ro. Пара {project}/{env} приезжает к нему из
# ПУТИ файла (#994), а не из того, чей это агент, поэтому разводить шиппер по
# нодам незачем.
name: birdman-vector

services:
  vector:
    image: {{ birdman_vector_image }}
    container_name: birdman-vector
    network_mode: host
    volumes:
      - /etc/birdman/vector.yaml:/etc/vector/vector.yaml:ro
{% for i in birdman_instances %}
      - "{{ i.log_dir }}/servers:{{ i.log_dir }}/servers:ro"
{% endfor %}
      - "{{ birdman_vector_data_dir }}:/vector-data-dir"
    restart: unless-stopped
