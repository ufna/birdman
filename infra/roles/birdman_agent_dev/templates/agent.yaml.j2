# {{ ansible_managed }}
# Конфиг birdman-agent (docs/specs/agent.md §10, итерация 1).
region: "{{ birdman_region }}"
capacity_slots: {{ birdman_capacity_slots }}
port_range: [{{ birdman_port_range[0] }}, {{ birdman_port_range[1] }}]
limits_default: { cpu_millis: {{ birdman_limits_default.cpu_millis }}, mem_mb: {{ birdman_limits_default.mem_mb }} }
log_dir: {{ birdman_log_dir }}
data_dir: {{ birdman_data_dir }}
registry_auth:
  username: "{{ birdman_registry_username }}"
  token_file: {{ birdman_registry_token_file }}   # токен только в файле 0600, не в конфиге
  host: "{{ birdman_registry_host | default('ghcr.io') }}"   # legacy-фоллбэк; основной путь — Админка → Реестры

# master-линк (итерация 1): master на этой же тачке, только localhost.
master_addr: "{{ birdman_master_addr }}"
node_token_file: {{ birdman_node_token_file }}    # выдан POST /v1/nodes; файл 0600
# mTLS agentlink v1 (дизайн §4): агент верифицирует цепочку master'а до
# внутренней CA + ServerName birdman-master, обменивает node_token на клиентский
# серт (Enroll). CA-серт кладёт ansible (GET /v1/ca). tls_cert_dir не задаём —
# дефолт {data_dir}/tls корректен.
tls_ca_file: {{ birdman_master_ca_file }}
