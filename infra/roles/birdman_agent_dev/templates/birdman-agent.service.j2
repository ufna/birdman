# {{ ansible_managed }}
[Unit]
Description=birdman node agent ({{ bmi.node_name }})
Documentation=file://{{ bmi.config_file }}
After=network-online.target containerd.service birdman-master.service
Wants=network-online.target
Requires=containerd.service

[Service]
Type=simple
# --socket-dir — каталог per-server liba-сокетов ЭТОЙ ноды: он бинд-маунтится
# внутрь дедика, поэтому у каждой ноды бокса он свой (tracker #1065).
ExecStart=/usr/local/bin/birdman-agent run --config {{ bmi.config_file }} --socket-dir {{ bmi.socket_dir }}
# Restart=always (НЕ on-failure): self-upgrade (agent.md §7) выходит ЧИСТО
# (exit 0) → systemd поднимает новый бинарь; при on-failure чистый выход не
# рестартовал бы и агент остался бы лежать (нода в карантин, буфер провис).
# `systemctl stop` — это commanded stop, его always не перезапускает (drain/
# NodeDown-учение работает). Быстрый рестарт (RestartSec) держит heartbeat-gap
# ниже порога карантина — живые дедики переживают апгрейд с теми же id.
Restart=always
RestartSec=2
# Агент — 0, дедикам агент выставляет oom_score_adj=500 (спека §3):
# при memory pressure ядро убивает дедики раньше агента.
OOMScoreAdjust=0
# SIGTERM → агент закрывает master-стрим и выходит, НЕ трогая живые дедики
# (agent.md §2); при следующем старте карта восстанавливается из
# containerd-labels, реконнект к master — с Hello и актуальной картой.

[Install]
WantedBy=multi-user.target
