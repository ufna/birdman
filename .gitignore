.DS_Store
.playwright-mcp/
*.log
.env
.env.*
# токен трекера (vikunja-mcp) — только локально, .env.* его НЕ ловит:
.vikunja-mcp.env
node_modules/
dist/
bin/
# Python bytecode (Ansible-роли под infra/):
__pycache__/
*.py[cod]
# Мутанты раннеров ролей: их кладёт рядом с оригиналом блок «часовой раннеров
# ролей» (infra/ci/tests/run.sh, tracker #1103) и убирает сразу же, в том числе
# из своего EXIT-trap'а при обрыве прогона (замерено на SIGTERM и SIGHUP —
# огрызка не остаётся). Страховка здесь — на случаи, когда bash до EXIT-trap'а
# не доходит вовсе (SIGKILL — по определению), чтобы огрызок не уехал в коммит.
infra/roles/*/tests/.run.sh.mutant.*
deploy/.env
deploy/secrets.key
# шаблон коммитим (иначе .env.* выше его проглотит):
!deploy/.env.example
# Доступы вне git (конвенция selfhost-v1): рабочий инвентарь и операционные
# доступы — только локально; в репо живут hosts.example.yml + STATUS-алиасы.
infra/inventories/dev/hosts.local.yml
docs/ACCESS.local.md
# Процессные доки superpowers переехали в приватный спутник (birdman-internal) —
# защита от случайного трека в публичный репо.
docs/superpowers/
# Локальная обвязка трекера и агента (конвенция selfhost-v1): конфиг трекера
# светит внутренний URL, остальное — машинно-локальные настройки сессий.
# Как восстановить на новой машине — birdman-internal/docs/ACCESS.md.
.vikunja-mcp.toml
.mcp.json
.claude/
